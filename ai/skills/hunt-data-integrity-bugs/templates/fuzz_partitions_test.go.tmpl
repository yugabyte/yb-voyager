//go:build unit

// Data-integrity hunt: partition-aware schedule fuzzer (needs fuzz_engine_test.go helpers).
//
// Models a LIST-partitioned table the way voyager sees it during live migration:
//   - every event carries the ROOT table name; Key = the leaf's own PK columns (Debezium key of
//     the leaf), BeforeFields = full old row (REPLICA IDENTITY FULL), Fields = changed columns.
//   - a partition-column UPDATE (row movement) arrives as DELETE(old leaf) + CREATE(new leaf).
//   - unique indexes defined on leaves are merged onto the root by column signature
//     (dedupeUniqueIndexes), NULLS NOT DISTINCT OR-ed; predicates are not evaluated.
//   - for custom-key tables the root's PK guard uses the root PK if it exists, otherwise ONE leaf's PK
//     (queryPGPrimaryKeyColumnsByCatalog picks via map iteration) - guardPK selects which.
//   - the target applies to the leaf (--use-partition-root false) or root (true); INSERT is
//     ON CONFLICT (event.Key) DO NOTHING, UPDATE/DELETE by event.Key with 0 rows as a warning.
//     Via the root, UPDATE/DELETE WHERE <leaf pk> hits every leaf with a matching row.
package cmd

import (
	"fmt"
	"math/rand"
	"sort"
	"strings"
	"testing"

	"github.com/yugabyte/yb-voyager/yb-voyager/src/tgtdb"
	"github.com/yugabyte/yb-voyager/yb-voyager/src/utils"
	"github.com/yugabyte/yb-voyager/yb-voyager/src/utils/sqlname"
)

type pfIndex struct {
	name   string
	cols   []string
	nnd    bool
	leaves []string         // leaf-local index on these leaves; nil = root-level (global) index
	pred   func(fzRow) bool // partial predicate
}

type pfScenario struct {
	name       string
	partCol    string
	leaves     []string
	cols       map[string][]*string // non-partition columns and their domains
	rootPK     []string             // nil = root has no PK
	leafPK     map[string][]string  // per-leaf PK (used when rootPK is nil)
	guardPK    []string             // PK columns voyager attributes to the root (nil = rootPK)
	uks        []pfIndex
	strategy   string
	customCols []string
	viaRoot    bool // --use-partition-root true
	moveRows   bool
	pkChange   bool
	nOps       int
	channels   int
}

type pfEngine struct {
	sc     pfScenario
	rng    *rand.Rand
	table  sqlname.NameTuple
	src    map[string]fzRow // key = leaf|pk
	events []*tgtdb.Event
	vsn    int64
	noDet  bool
	colOrd []string
}

func (e *pfEngine) pkCols(leaf string) []string {
	if e.sc.rootPK != nil {
		return e.sc.rootPK
	}
	return e.sc.leafPK[leaf]
}

func val(v *string) string {
	if v == nil {
		return "\x00NULL"
	}
	return *v
}

func (e *pfEngine) rowKey(r fzRow) string {
	leaf := *r[e.sc.partCol]
	parts := []string{leaf}
	if e.sc.rootPK != nil {
		parts = []string{"root"} // root-level PK is global
	}
	for _, c := range e.pkCols(leaf) {
		parts = append(parts, val(r[c]))
	}
	return strings.Join(parts, "|")
}

func (e *pfEngine) inIndex(ix pfIndex, r fzRow) bool {
	if ix.pred != nil && !ix.pred(r) {
		return false
	}
	if ix.leaves == nil {
		return true
	}
	return lo_contains(ix.leaves, *r[e.sc.partCol])
}

func (e *pfEngine) ukCollide(ix pfIndex, a, b fzRow) bool {
	if !e.inIndex(ix, a) || !e.inIndex(ix, b) {
		return false
	}
	if ix.leaves != nil && *a[e.sc.partCol] != *b[e.sc.partCol] {
		return false // leaf-local: only rows in the same leaf compete
	}
	for _, c := range ix.cols {
		va, vb := a[c], b[c]
		if va == nil || vb == nil {
			if ix.nnd && va == nil && vb == nil {
				continue
			}
			return false
		}
		if *va != *vb {
			return false
		}
	}
	return true
}

func (e *pfEngine) violates(rows map[string]fzRow, r fzRow, self string) string {
	if o, ok := rows[e.rowKey(r)]; ok && e.rowKey(r) != self && o != nil {
		return "pk"
	}
	for _, ix := range e.sc.uks {
		for k, o := range rows {
			if k != self && e.ukCollide(ix, r, o) {
				return ix.name
			}
		}
	}
	return ""
}

func (e *pfEngine) pick(dom []*string) *string {
	v := dom[e.rng.Intn(len(dom))]
	if v == nil {
		return nil
	}
	vv := *v
	return &vv
}

func (e *pfEngine) keyOf(r fzRow) map[string]*string {
	k := map[string]*string{}
	for _, c := range e.pkCols(*r[e.sc.partCol]) {
		k[c] = copyRow(r)[c]
	}
	return k
}

func (e *pfEngine) emit(op string, before, fields fzRow, key map[string]*string) {
	e.vsn++
	ev := &tgtdb.Event{Vsn: e.vsn, Op: op, TableNameTup: e.table, Key: key, Fields: fields, BeforeFields: before, ExporterRole: SOURCE_DB_EXPORTER_ROLE}
	if op == "c" {
		ev.BeforeFields = nil
	}
	ev.AfterFields = tgtdb.GenerateAfterFields(op, ev.BeforeFields, ev.Fields)
	e.events = append(e.events, ev)
}

func (e *pfEngine) randRow() fzRow {
	r := fzRow{e.sc.partCol: sp(e.sc.leaves[e.rng.Intn(len(e.sc.leaves))])}
	for _, c := range e.colOrd {
		r[c] = e.pick(e.sc.cols[c])
	}
	return r
}

func (e *pfEngine) pkNil(r fzRow) bool {
	for _, c := range e.pkCols(*r[e.sc.partCol]) {
		if r[c] == nil {
			return true
		}
	}
	return false
}

func (e *pfEngine) isKeyCol(c string, leaf string) bool {
	return lo_contains(e.pkCols(leaf), c) || lo_contains(e.sc.customCols, c) || c == e.sc.partCol
}

func (e *pfEngine) gen() {
	for i := 0; i < e.sc.nOps; i++ {
		keys := make([]string, 0, len(e.src))
		for k := range e.src {
			keys = append(keys, k)
		}
		sort.Strings(keys)
		x := e.rng.Intn(12)
		switch {
		case x < 4 || len(keys) == 0:
			r := e.randRow()
			if e.pkNil(r) || e.violates(e.src, r, "") != "" {
				continue
			}
			e.src[e.rowKey(r)] = r
			e.emit("c", nil, copyRow(r), e.keyOf(r))
		case x < 7:
			k := keys[e.rng.Intn(len(keys))]
			before := e.src[k]
			after := copyRow(before)
			changed := fzRow{}
			for _, c := range e.colOrd {
				if e.isKeyCol(c, *before[e.sc.partCol]) || e.rng.Intn(2) == 0 {
					continue
				}
				nv := e.pick(e.sc.cols[c])
				if val(nv) != val(after[c]) {
					after[c] = nv
					changed[c] = copyRow(fzRow{"x": nv})["x"]
				}
			}
			if len(changed) == 0 || e.violates(e.src, after, k) != "" {
				continue
			}
			e.src[k] = after
			e.emit("u", copyRow(before), changed, e.keyOf(before))
		case x < 9:
			k := keys[e.rng.Intn(len(keys))]
			before := e.src[k]
			delete(e.src, k)
			e.emit("d", copyRow(before), nil, e.keyOf(before))
		case x < 11: // row movement: change the partition column -> DELETE + CREATE
			if !e.sc.moveRows {
				continue
			}
			if lo_contains(e.sc.customCols, e.sc.partCol) && false {
				continue
			}
			k := keys[e.rng.Intn(len(keys))]
			before := e.src[k]
			after := copyRow(before)
			after[e.sc.partCol] = sp(e.sc.leaves[e.rng.Intn(len(e.sc.leaves))])
			if *after[e.sc.partCol] == *before[e.sc.partCol] || e.pkNil(after) {
				continue
			}
			delete(e.src, k)
			if e.violates(e.src, after, "") != "" {
				e.src[k] = before
				continue
			}
			e.src[e.rowKey(after)] = after
			e.emit("d", copyRow(before), nil, e.keyOf(before))
			e.emit("c", nil, copyRow(after), e.keyOf(after))
		default: // PK change inside the same leaf -> DELETE + CREATE
			if !e.sc.pkChange {
				continue
			}
			k := keys[e.rng.Intn(len(keys))]
			before := e.src[k]
			after := copyRow(before)
			for _, c := range e.pkCols(*before[e.sc.partCol]) {
				if c != e.sc.partCol {
					after[c] = e.pick(e.sc.cols[c])
				}
			}
			if e.pkNil(after) || e.rowKey(after) == k {
				continue
			}
			delete(e.src, k)
			if e.violates(e.src, after, "") != "" {
				e.src[k] = before
				continue
			}
			e.src[e.rowKey(after)] = after
			e.emit("d", copyRow(before), nil, e.keyOf(before))
			e.emit("c", nil, copyRow(after), e.keyOf(after))
		}
	}
}

// target rows keyed by leaf|<values of that leaf's PK>; the root-level PK case keys globally.
func (e *pfEngine) tgtKey(leaf string, key map[string]*string) string {
	cols := make([]string, 0, len(key))
	for c := range key {
		cols = append(cols, c)
	}
	sort.Strings(cols)
	parts := []string{leaf}
	if e.sc.rootPK != nil {
		parts = []string{"root"}
	}
	for _, c := range e.pkCols(leaf) {
		parts = append(parts, val(key[c]))
	}
	return strings.Join(parts, "|")
}

func matchesKey(r fzRow, key map[string]*string) bool {
	for c, v := range key {
		if val(r[c]) != val(v) {
			return false
		}
	}
	return true
}

func (e *pfEngine) apply(tgt map[string]fzRow, ev *tgtdb.Event) (string, string) {
	var leaf string
	if ev.Op == "c" {
		leaf = *ev.Fields[e.sc.partCol]
	} else {
		leaf = *ev.BeforeFields[e.sc.partCol]
	}
	// which target rows does a WHERE <event.Key> statement touch?
	targets := func() []string {
		if !e.sc.viaRoot {
			k := e.tgtKey(leaf, ev.Key)
			if _, ok := tgt[k]; ok {
				return []string{k}
			}
			return nil
		}
		var ks []string
		for k, r := range tgt {
			if matchesKey(r, ev.Key) {
				ks = append(ks, k)
			}
		}
		sort.Strings(ks)
		return ks
	}
	switch ev.Op {
	case "c":
		r := copyRow(ev.Fields)
		k := e.rowKey(r)
		if _, exists := tgt[k]; exists {
			return "", fmt.Sprintf("vsn=%d INSERT skipped by ON CONFLICT DO NOTHING", ev.Vsn)
		}
		if v := e.violates(tgt, r, ""); v != "" {
			return fmt.Sprintf("vsn=%d INSERT unique violation on %s", ev.Vsn, v), ""
		}
		tgt[k] = r
	case "u":
		ks := targets()
		if len(ks) == 0 {
			return "", fmt.Sprintf("vsn=%d UPDATE affected 0 rows", ev.Vsn)
		}
		for _, k := range ks {
			nr := copyRow(tgt[k])
			for c, v := range ev.Fields {
				nr[c] = v
			}
			if v := e.violates(tgt, nr, k); v != "" {
				return fmt.Sprintf("vsn=%d UPDATE unique violation on %s", ev.Vsn, v), ""
			}
			tgt[k] = nr
		}
		if len(ks) > 1 {
			return "", fmt.Sprintf("vsn=%d UPDATE via root affected %d rows", ev.Vsn, len(ks))
		}
	case "d":
		ks := targets()
		if len(ks) == 0 {
			return "", fmt.Sprintf("vsn=%d DELETE affected 0 rows", ev.Vsn)
		}
		for _, k := range ks {
			delete(tgt, k)
		}
		if len(ks) > 1 {
			return "", fmt.Sprintf("vsn=%d DELETE via root affected %d rows", ev.Vsn, len(ks))
		}
	}
	return "", ""
}

func (e *pfEngine) run() string {
	old := NUM_EVENT_CHANNELS
	NUM_EVENT_CHANNELS = e.sc.channels
	defer func() { NUM_EVENT_CHANNELS = old }()

	// merge leaf/root unique indexes by column signature like dedupeUniqueIndexes
	var uks []tgtdb.UniqueIndex
	for _, ix := range e.sc.uks {
		uks = append(uks, tgtdb.UniqueIndex{IndexName: ix.name, Columns: ix.cols, NullsNotDistinct: ix.nnd})
	}
	uks = dedupeForTest(uks)
	tableToUK := utils.NewStructMap[sqlname.NameTuple, []tgtdb.UniqueIndex]()
	tableToUK.Put(e.table, uks)
	pkMap := utils.NewStructMap[sqlname.NameTuple, cdcPartitionKeyOverride]()
	pkMap.Put(e.table, cdcPartitionKeyOverride{Strategy: e.sc.strategy, Columns: append([]string{}, e.sc.customCols...)})
	guard := e.sc.guardPK
	if guard == nil {
		guard = e.sc.rootPK
	}
	pkCols := utils.NewStructMap[sqlname.NameTuple, []string]()
	pkCols.Put(e.table, guard)
	if err := addPrimaryKeyToConflictSetForCustomTables(tableToUK, []sqlname.NameTuple{e.table}, pkMap, pkCols); err != nil {
		return "setup: " + err.Error()
	}
	chans := make([]chan *tgtdb.Event, e.sc.channels)
	for i := range chans {
		chans[i] = make(chan *tgtdb.Event, 1<<16)
	}
	cache := NewConflictDetectionCache(tableToUK, chans, POSTGRESQL, pkMap)
	tgt := map[string]fzRow{}
	queues := make([][]*tgtdb.Event, e.sc.channels)
	next := 0
	var warns []string
	for {
		ready := false
		var h int
		var ev *tgtdb.Event
		if next < len(e.events) {
			ev = e.events[next]
			var err error
			if h, err = hashEvent(ev, pkMap); err != nil {
				return fmt.Sprintf("hashEvent vsn=%d: %v", ev.Vsn, err)
			}
			ok, err := shouldHandleConflicts(ev, tableToUK, pkMap)
			if err != nil {
				return err.Error()
			}
			blocked := false
			if ok && ev.Op != "d" {
				cache.Lock()
				conf, err := cache.findConflictLocked(ev)
				cache.Unlock()
				if err != nil {
					return fmt.Sprintf("findConflict vsn=%d: %v", ev.Vsn, err)
				}
				blocked = len(conf) > 0 && !e.noDet
			}
			ready = !blocked
		}
		var rc []int
		for i, q := range queues {
			if len(q) > 0 {
				rc = append(rc, i)
			}
		}
		if !ready && len(rc) == 0 {
			if next < len(e.events) {
				return fmt.Sprintf("DEADLOCK at vsn=%d", e.events[next].Vsn)
			}
			break
		}
		choice := e.rng.Intn(len(rc) + lo_ternaryInt(ready, 1, 0))
		if ready && choice == len(rc) {
			ok, _ := shouldHandleConflicts(ev, tableToUK, pkMap)
			if ok && (ev.Op == "d" || ev.Op == "u") {
				if err := cache.Put(ev); err != nil {
					return fmt.Sprintf("Put vsn=%d: %v", ev.Vsn, err)
				}
			}
			queues[h] = append(queues[h], ev)
			next++
			continue
		}
		ch := rc[choice]
		x := queues[ch][0]
		queues[ch] = queues[ch][1:]
		crash, warn := e.apply(tgt, x)
		if crash != "" {
			return "CRASH: " + crash
		}
		if warn != "" {
			warns = append(warns, warn)
		}
		cache.RemoveEvents(x)
	}
	var diffs []string
	for k, r := range e.src {
		t, ok := tgt[k]
		if !ok {
			diffs = append(diffs, "missing: "+rowString(r))
		} else if rowString(t) != rowString(r) {
			diffs = append(diffs, fmt.Sprintf("differs src{%s} tgt{%s}", rowString(r), rowString(t)))
		}
	}
	for k, t := range tgt {
		if _, ok := e.src[k]; !ok {
			diffs = append(diffs, "extra: "+rowString(t))
		}
	}
	if len(diffs) > 0 {
		sort.Strings(diffs)
		return "DATA DIVERGENCE: " + strings.Join(diffs, "; ")
	}
	return ""
}

func dedupeForTest(ixs []tgtdb.UniqueIndex) []tgtdb.UniqueIndex {
	pos := map[string]int{}
	var out []tgtdb.UniqueIndex
	for _, ix := range ixs {
		k := strings.Join(ix.Columns, ",")
		if p, ok := pos[k]; ok {
			out[p].NullsNotDistinct = out[p].NullsNotDistinct || ix.NullsNotDistinct
			continue
		}
		pos[k] = len(out)
		out = append(out, ix)
	}
	return out
}

func pfFuzz(sc pfScenario, seeds, scheds int, noDet bool) (int, string) {
	fails, sample := 0, ""
	for seed := 0; seed < seeds; seed++ {
		oname := sqlname.NewObjectName(YUGABYTEDB, "public", "public", "pf_root")
		e := &pfEngine{sc: sc, rng: rand.New(rand.NewSource(int64(seed))), table: sqlname.NameTuple{CurrentName: oname, TargetName: oname},
			src: map[string]fzRow{}, noDet: noDet}
		for c := range sc.cols {
			e.colOrd = append(e.colOrd, c)
		}
		sort.Strings(e.colOrd)
		e.gen()
		for s := 0; s < scheds; s++ {
			e.rng = rand.New(rand.NewSource(int64(seed*7919 + s)))
			if res := e.run(); res != "" {
				fails++
				if sample == "" {
					sample = fmt.Sprintf("seed=%d sched=%d events=%d: %s", seed, s, len(e.events), truncate(res, 500))
				}
			}
		}
	}
	return fails, sample
}

func TestDataIntegrityFuzz_Partitions(t *testing.T) {
	leaves := []string{"r1", "r2", "r3"}
	idDom := ints(1, 5)
	curPred := func(r fzRow) bool { return r["cur"] != nil && *r["cur"] == "true" }
	base := func() map[string][]*string {
		return map[string][]*string{"id": idDom, "k": ints(1, 3), "u": ints(1, 3), "v": ints(1, 3)}
	}
	leafPKid := map[string][]string{"r1": {"id"}, "r2": {"id"}, "r3": {"id"}}
	mixedPK := map[string][]string{"r1": {"id"}, "r2": {"id", "sub"}, "r3": {"id", "sub"}}

	type row struct {
		sc         pfScenario
		expectFail bool
		why        string
	}
	cases := []row{
		// P1: root PK (id, region), custom key = partition column, row movement, root-level UK (u, region)
		{pfScenario{name: "P1 rootPK customKey=partcol rowmove", partCol: "region", leaves: leaves, cols: base(), rootPK: []string{"id", "region"},
			uks: []pfIndex{{name: "uk_u_region", cols: []string{"u", "region"}}}, strategy: PARTITION_BY_CUSTOM, customCols: []string{"region"},
			moveRows: true, pkChange: true, nOps: 150, channels: 7}, false, ""},
		// P2: root without PK, leaf PK (id), leaf-root false, custom key = partition column, row movement
		{pfScenario{name: "P2 leafPK(id) customKey=partcol rowmove", partCol: "region", leaves: leaves, cols: base(), leafPK: leafPKid, guardPK: []string{"id"},
			strategy: PARTITION_BY_CUSTOM, customCols: []string{"region"}, moveRows: true, pkChange: true, nOps: 150, channels: 7}, false, ""},
		// P3: root without PK, leaf PK (id), custom key k (not partition col), row movement, leaf-local UK (u) on all leaves
		{pfScenario{name: "P3 leafPK(id) customKey=k leafUK(u) all leaves", partCol: "region", leaves: leaves, cols: base(), leafPK: leafPKid, guardPK: []string{"id"},
			uks: []pfIndex{{name: "uk_u", cols: []string{"u"}, leaves: leaves}}, strategy: PARTITION_BY_CUSTOM, customCols: []string{"k"},
			moveRows: true, pkChange: true, nOps: 150, channels: 7}, false, ""},
		// P4: leaf-local UK only on r1; custom key k
		{pfScenario{name: "P4 leafUK only on r1 customKey=k", partCol: "region", leaves: leaves, cols: base(), leafPK: leafPKid, guardPK: []string{"id"},
			uks: []pfIndex{{name: "uk_u_r1", cols: []string{"u"}, leaves: []string{"r1"}}}, strategy: PARTITION_BY_CUSTOM, customCols: []string{"k"},
			moveRows: true, pkChange: true, nOps: 150, channels: 7}, false, ""},
		// P5: nullable custom key on partitioned table + partial leaf UK
		{pfScenario{name: "P5 nullable customKey + partial leaf UK", partCol: "region", leaves: leaves,
			cols:   map[string][]*string{"id": idDom, "k": withNull(ints(1, 2)), "u": ints(1, 2), "cur": vals("true", "false")},
			leafPK: leafPKid, guardPK: []string{"id"},
			uks: []pfIndex{{name: "uk_u_cur", cols: []string{"u", "cur"}, leaves: leaves, pred: curPred}}, strategy: PARTITION_BY_CUSTOM, customCols: []string{"k"},
			moveRows: true, nOps: 150, channels: 7}, false, ""},
		// P6: composite custom key (k, region)
		{pfScenario{name: "P6 composite customKey (k,region)", partCol: "region", leaves: leaves, cols: base(), leafPK: leafPKid, guardPK: []string{"id"},
			uks: []pfIndex{{name: "uk_u", cols: []string{"u"}, leaves: leaves}}, strategy: PARTITION_BY_CUSTOM, customCols: []string{"k", "region"},
			moveRows: true, pkChange: true, nOps: 150, channels: 7}, false, ""},
		// P7: pk routing, leaf PK (id), row movement (same id across leaves)
		{pfScenario{name: "P7 pk routing leafPK(id) rowmove", partCol: "region", leaves: leaves, cols: base(), leafPK: leafPKid,
			uks: []pfIndex{{name: "uk_u", cols: []string{"u"}, leaves: leaves}}, strategy: PARTITION_BY_PK, moveRows: true, pkChange: true, nOps: 150, channels: 7}, false, ""},
		// P8: root PK, via root (default), custom key k, row movement
		{pfScenario{name: "P8 viaRoot rootPK customKey=k rowmove", partCol: "region", leaves: leaves, cols: base(), rootPK: []string{"id", "region"},
			uks: []pfIndex{{name: "uk_u_region", cols: []string{"u", "region"}}}, strategy: PARTITION_BY_CUSTOM, customCols: []string{"k"}, viaRoot: true,
			moveRows: true, pkChange: true, nOps: 150, channels: 7}, false, ""},
		// P9/P10: leaves with DIFFERENT PKs; guard attributed from r1 (id) vs from r2 (id,sub)
		{pfScenario{name: "P9 mixed leaf PKs guard=(id)", partCol: "region", leaves: leaves,
			cols: map[string][]*string{"id": idDom, "sub": ints(1, 2), "k": ints(1, 3), "v": ints(1, 3)}, leafPK: mixedPK, guardPK: []string{"id"},
			strategy: PARTITION_BY_CUSTOM, customCols: []string{"k"}, moveRows: true, pkChange: true, nOps: 150, channels: 7}, false, ""},
		{pfScenario{name: "P10 mixed leaf PKs guard=(id,sub)", partCol: "region", leaves: leaves,
			cols: map[string][]*string{"id": idDom, "sub": ints(1, 2), "k": ints(1, 3), "v": ints(1, 3)}, leafPK: mixedPK, guardPK: []string{"id", "sub"},
			strategy: PARTITION_BY_CUSTOM, customCols: []string{"k"}, moveRows: true, pkChange: true, nOps: 150, channels: 7}, true,
			"guard (id,sub) does not cover r1's PK (id): r1 PK recycle across custom keys is not serialised"},
		// P11: leaf PK (id), use-partition-root TRUE (root has no PK): UPDATE/DELETE WHERE id hit every leaf
		{pfScenario{name: "P11 viaRoot with leaf-only PK (id)", partCol: "region", leaves: leaves, cols: base(), leafPK: leafPKid,
			strategy: PARTITION_BY_PK, viaRoot: true, moveRows: true, nOps: 150, channels: 7}, true,
			"root has no PK; statements via the root match the same id in every leaf (voyager requires --use-partition-root false here)"},
	}
	for _, c := range cases {
		c := c
		t.Run(c.sc.name, func(t *testing.T) {
			fails, sample := pfFuzz(c.sc, 40, 25, false)
			t.Logf("PRESULT %-45s failing schedules: %4d/1000 expectFail=%v", c.sc.name, fails, c.expectFail)
			if sample != "" {
				t.Logf("  sample: %s", sample)
			}
			if !c.expectFail {
				mf, ms := pfFuzz(c.sc, 40, 25, true)
				t.Logf("  MUTANT (detection off): %4d/1000 %s", mf, truncate(ms, 150))
				if fails > 0 {
					t.Errorf("unexpected failure in %s: %s", c.sc.name, sample)
				}
			}
		})
	}
}
