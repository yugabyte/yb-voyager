# LONG-RUNNING (72h) spike/recovery soak on the anonymized GoCardless schema (339 flat
# tables in public, generated by event-generator/gocardless_prep.py --schema public).
# ONE live-migration instance kept running across the whole soak (customer running a
# migration over a weekend): forward migrate -> cutover-to-target -> fall-back leg stays
# up for 72h with a recurring write spike (13k commanded ~= 11k delivered) every hour and
# baseline load between spikes. `archive changes --policy delete` runs continuously so
# consumed queue segments are reclaimed (72h of segments would otherwise exhaust disk).
# Import to source is throttled (parallel-jobs: 2) so the export->import lag is visible;
# the monitor also records replication-slot lag (pg_wal_lsn_diff vs confirmed_flush_lsn).
# Pass/fail is lag recovery + row-count/row-hash at both cutovers, never achieved rate.
# Target DB parameters are env-substituted (Jenkins); see scenario.yaml.template.

name: spike-regular-gocardless-cluster

num_iterations: 1

env:
  LOG_LEVEL: info
  QUEUE_SEGMENT_MAX_BYTES: 10485760

export_dir: ./spike-export-dir
artifacts_dir: ./spike-artifacts

source:
  type: postgresql
  host: 127.0.0.1
  port: 5432
  database: test_db
  user: ybvoyager
  password: Test@123#$%^&*()!
  schema: public
  admin:
    user: postgres
    password: postgres

target:
  type: yugabytedb
  host: ${TARGET_DB_HOST}
  port: ${TARGET_DB_PORT}
  database: test_db
  user: ${TARGET_DB_USER}
  password: ${TARGET_DB_PASSWORD}
  admin:
    user: ${TARGET_DB_ADMIN_USER}
    password: ${TARGET_DB_ADMIN_PASSWORD}

generator_source:
  config_inline:
    connection:
      host: 127.0.0.1
      port: 5432
      database: test_db
      user: postgres
      password: postgres
    generator:
      schema_name: public
      manual_table_list: []
      exclude_table_list: [cutover_table, migration_validate_segments]
      num_iterations: -1
      wait_after_operations: 200
      wait_duration_seconds: 1
      table_weights: {}
      operation_weights: {INSERT: 3, UPDATE: 2, DELETE: 1}
      random_seed: 123
      faker_seed: 123
      insert_rows: 10
      update_rows: 5
      delete_rows: 2
      insert_max_retries: 5
      update_max_retries: 1

generator_target:
  config_inline:
    connection:
      host: ${TARGET_DB_HOST}
      port: ${TARGET_DB_PORT}
      database: test_db
      user: ${TARGET_DB_USER}
      password: ${TARGET_DB_PASSWORD}
    generator:
      schema_name: public
      manual_table_list: []
      exclude_table_list: [cutover_table, migration_validate_segments]
      num_iterations: -1
      # Required by the generator config schema; inert when rate_control drives.
      wait_after_operations: 0
      wait_duration_seconds: 0
      table_weights: {}
      operation_weights: {INSERT: 3, UPDATE: 2, DELETE: 1}
      random_seed: 456
      faker_seed: 456
      insert_rows: 25
      update_rows: 12
      delete_rows: 6
      insert_max_retries: 5
      update_max_retries: 1
      # Regular: baseline 1.5k, 10k spike for 5 min at the 10-min mark (one spike in the 30-min soak).
      rate_control:
        default_events_per_second: 1500
        report_interval_seconds: 60
        schedule:
          - {events_per_second: 13000, duration_seconds: 200, every_seconds: 3600, offset_seconds: 300, jitter_pct: 0}
    parallel:
      # During the LIVE spike each worker only sustains ~467 ev/s (CDC export load +
      # populated indexes + RF3 contention drop it well below the ~900 solo calibration),
      # so 18 workers capped delivered at 8.4k. 28 workers x ~467 ~= 13k gives comfortable
      # headroom to hold a flat 10k. Planner sizes off SOLO calibration, so margin must be
      # high enough to saturate max_workers: ceil(10000*margin/900) >= 28 needs margin >= 2.6.
      max_workers: 28
      # 339-table schema analysis takes ~35s per worker; a short calibration
      # window measures 0 rows -> per_worker_ceiling=0 -> crash. Give it room.
      calibration_seconds: 120
      margin: 2.6
      run_seconds: 259200
      monitor_interval_seconds: 60

voyager:
  export_schema:
    flags:
      skip-performance-recommendations: "true"
  cutover_to_target:
    flags:
      prepare-for-fall-back: true
  cutover_to_source:
    flags:
      restart-data-migration-source-target: true
  import_to_source:
    flags:
      # Throttle fall-back import WELL below the single-slot export rate so a clearly
      # visible lag builds between export and import. Measured: 5 jobs over RDS kept
      # pace with a ~7.8k export (~1.5k/job) -> lines overlapped. 2 jobs (~3k) sits
      # above the 1.5k baseline (backlog still drains) but far below the ~7-8k export,
      # so the export/import lines separate and the lag panel shows a real triangle.
      parallel-jobs: 2

stages:
  - name: create_source_and_target_dbs
    action: reset_databases
    targets: [source, target]

  - name: create_source_schema
    action: run_sql
    sql_path: ./gocardless-schema.sql
    use_admin: true

  - name: increase_temp_file_limit_source
    action: run_sql
    sql_path: ./temp_file_limit.sql
    target: source
    use_admin: true

  - name: increase_temp_file_limit_target
    action: run_sql
    sql_path: ./temp_file_limit.sql
    target: target
    use_admin: true

  - name: create_cutover_table
    action: create_cutover_table
    target: [source]

  - name: grant_source_permissions
    action: grant_source_permissions
    is_live_migration_fall_back: 1

  - name: export_schema_from_source
    action: voyager_export_schema

  - name: import_schema_on_target
    action: voyager_import_schema

  # ---- Phase 1: forward migrate + cutover to target ----
  - name: start_exporter
    action: voyager_export_start

  - name: start_importer
    action: voyager_import_start

  - name: start_baseline_generator
    action: generator_start
    generator_key: generator_source

  - name: wait_exporter_streaming
    action: wait_for
    condition: exporter_in_streaming_phase
    timeout_sec: 600

  - name: start_archiver
    action: voyager_archive_changes_start
    policy: delete

  - name: seed_soak
    action: sleep
    seconds: 120

  - name: stop_baseline_generator
    action: generator_stop
    generator_key: generator_source
    graceful_timeout_sec: 30

  - name: insert_backlog_marker
    action: run_sql
    target: source
    sql_path: ../common-sql/insert_marker.sql

  - name: wait_backlog_zero
    action: wait_for
    condition: remaining_events_eq_0
    timeout_sec: 600

  - name: wait_for_archiver
    action: sleep
    seconds: 60

  - name: validate_archive_changes
    action: validate_archive_changes

  - name: cutover_to_target
    action: cutover_to_target

  - name: wait_cutover_to_target_completed
    action: wait_for
    condition: cutover_to_target_status_completed
    timeout_sec: 300

  # Forward export/import must stay running until cutover COMPLETES (they consume
  # the cutover event); only then stop them and validate.
  - name: stop_forward_exporter
    action: voyager_stop_command
    command: export_data
    graceful_timeout_sec: 60

  - name: stop_forward_importer
    action: voyager_stop_command
    command: import_data
    graceful_timeout_sec: 60

  - name: row_count_validations
    action: row_count_validations

  - name: row_hash_validations
    action: row_hash_validations

  # ---- Phase 2: fall-back spike + recovery ----
  - name: start_fallback_exporter_from_target
    action: voyager_export_from_target_start

  - name: start_fallback_importer_to_source
    action: voyager_import_to_source_start

  - name: start_throughput_monitor
    action: monitor_start
    exporter_role: target_db_exporter_fb
    import_role: source
    interval_sec: 60

  - name: start_spike_generator
    action: generator_start
    generator_key: generator_target

  - name: spike_soak
    action: sleep
    seconds: 259200

  - name: stop_spike_generator
    action: generator_stop
    generator_key: generator_target
    graceful_timeout_sec: 60

  - name: insert_backlog_marker_on_target
    action: run_sql
    target: target
    sql_path: ../common-sql/insert_marker.sql

  # With import throttled to 2 jobs (~3k ev/s), the ~2M-event spike backlog drains at
  # only ~1.5k/s net while the 1.5k baseline still flows — needs well over 1800s.
  - name: wait_backlog_zero_after_fallback
    action: wait_for
    condition: remaining_events_eq_0
    timeout_sec: 3600

  - name: wait_for_archiver_fallback
    action: sleep
    seconds: 60

  - name: validate_archive_changes_fallback
    action: validate_archive_changes

  - name: stop_throughput_monitor
    action: monitor_stop
    graceful_timeout_sec: 30

  - name: plot_throughput
    action: plot_throughput

  - name: validate_recovery
    action: validate_recovery

  - name: cutover_to_source
    action: cutover_to_source

  - name: wait_cutover_to_source_completed
    action: wait_for
    condition: cutover_to_source_status_completed
    timeout_sec: 300

  - name: row_count_validations_fallback
    action: row_count_validations

  - name: row_hash_validations_fallback
    action: row_hash_validations
